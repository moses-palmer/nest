#!/bin/sh
#
## Converts a commit to a branch name.
##
## Usage: git commit-to-branch [COMMIT]
##
## If COMMIT is not specified, HEAD is used.
##
## This script will output a branch name only if the the branch HEAD is the
## commit specified.

set -e
. ~/.local/lib/bash/autohelp

COMMIT="$(git rev-parse "${1:-HEAD}")"
BRANCH="$(git branch --format="%(objectname) %(refname)" \
    | grep "^$COMMIT " \
    | sed 's:[a-f0-9].* refs/heads/::')"

if [ -n "$BRANCH" ]; then
    echo "$BRANCH"
else
    exit 1
fi
