#!/bin/bash
#
## Launches a project in the current tmux window.
##
## Usage: tmux-project open | quit
##
## tmux-project open opens a project in the current window.
##
## tmux-project quit closes all panes in the current window if the current
## window is a project window.

. ~/.local/lib/bash/autohelp
. ~/.config/tmux-project


ROOT="${TMUX_PROJECT_ROOT:-$(tmux display-message -p "#{pane_current_path}")}"
WINDOW="$(tmux display-message -p "#{window_id}")"
PANE="$(tmux display-message -p "#{pane_id}")"


##
# Determines whether the current window has a pane with of specific type.
#
# This is true if the tmux window option designated by $2 is set to an existing
# pane.
#
# Arguments:
# $1: The ID of the window to check.
# $2: The type of pane.
tmux_project_has_pane() {
    local window="$1"
    local var="$2"
    local pane_id="$(tmux show-window-option -v -t "$window" "$var" \
        2>/dev/null)"
    [ -n "$pane_id" ] && tmux has-session -t "$pane_id"
}


cd "$ROOT"
case "$1" in
    open)
        . ~/.local/lib/tmux-project-open
        ;;
    quit)
        . ~/.local/lib/tmux-project-quit
        ;;
    select)
        . ~/.local/lib/tmux-project-select
        ;;
    *)
        echo "Unknown command: $1"
        exit 1
        ;;
esac
