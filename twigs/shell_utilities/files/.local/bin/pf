#!/bin/sh
#
## Displays information about all running processes given a binary name.
##
## The process ID is printed to stdout and other pieces of information are
## printed to stderr.
##
## Usage: pf [--only-pid] BINARY
##
## Passing --only-pid suppresses additional information. This is the default
## behaviour when no procfs is present.

set -e
. ~/.local/lib/bash/autohelp


if [ "$1" = "--only-pid" ]; then
    ONLY_PID="yes"
    shift
fi

require_argument "${1:-}" COMMAND


bin="$(tput bold)"
arg="$(tput setaf 7)"
c="$(tput sgr0)"

ps -A -o pid -o comm \
| grep "[ 0-9]\+ \(.*/\)\?$COMMAND" \
| sed 's/\s*\([0-9]\+\).*/\1/' \
| while read pid; do
    echo "$pid"
    if [ -z "$ONLY_PID" ]; then
        dir="/proc/$pid"
        if ! [ -d "$dir" ]; then
            continue
        fi
        echo "${bin}$(readlink "$dir/exe")${c} in $(readlink "${dir}/cwd")" >&2
        echo "$(cat "$dir/cmdline" \
            | tr '\0' '\n' \
            | sed "s/\(.*\)/   \x1b[1;32m\1\x1b[0m/g")" >&2
        echo >&2
    fi
done
